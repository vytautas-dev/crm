# Supabase — app runtime (server-only secrets, declared in astro.config.mjs env.schema).
# Copy the values printed by `npx supabase start` (local) or your cloud project's API settings.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=<anon / publishable key>

# Supabase — RLS canary test only (`npm test`). Not used by the app runtime.
# SERVICE_ROLE_KEY: the secret key from `npx supabase start` — used solely to create/delete
# the two test users via auth.admin. SUPABASE_DB_URL: the direct Postgres connection used to
# apply/drop the throwaway canary table (DDL the anon client cannot perform).
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
