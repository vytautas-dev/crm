---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import CompaniesView from "@/components/companies/CompaniesView";
import { createClient } from "@/lib/supabase";
import { listActiveCompanies } from "@/lib/services/companies";
import type { Company } from "@/types";

// Middleware already guards this route; fetch the initial list server-side so
// the island paints without a spinner.
let initialCompanies: Company[] = [];
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  const result = await listActiveCompanies(supabase);
  if (result.ok) {
    initialCompanies = result.data;
  }
}
---

<Layout title="Companies">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-4xl">
      <Topbar />
      <CompaniesView client:load initialCompanies={initialCompanies} />
    </div>
  </div>
</Layout>
